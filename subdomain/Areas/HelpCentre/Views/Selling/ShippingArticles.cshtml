@{
    ViewData["Title"] = "Shipping - Lively Help Center";
    ViewData["CategorySlug"] = "Selling";
    ViewData["SubCategorySlug"] = "Shipping";
    ViewData["HeroTitle"] = "Shipping";
    ViewData["HeroStyle"] = "background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/help_centre_img/help_area/help_centre_hero_bg.png');";
}

<div class="container py-5 content-container">
    <div class="row g-4">

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="SetUpShipping" class="text-decoration-none" style="color: var(--lively-blue);">Set up shipping</a></h5>
            <p class="text-muted small">Review your shipping settings and item weights before you start selling...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ShipAnOrder" class="text-decoration-none" style="color: var(--lively-blue);">Ship an order</a></h5>
            <p class="text-muted small">Learn how to pack, label, and drop off your orders after a sale...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ManageShipments" class="text-decoration-none" style="color: var(--lively-blue);">Manage your shipments</a></h5>
            <p class="text-muted small">Review, edit, and track your shipments from Seller Hub...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="FixShippingProblem" class="text-decoration-none" style="color: var(--lively-blue);">Fix a problem with shipping</a></h5>
            <p class="text-muted small">Learn how to resolve issues with labels, weights, or delivery...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ShipInternationally" class="text-decoration-none" style="color: var(--lively-blue);">Ship internationally</a></h5>
            <p class="text-muted small">Understand how to fulfill and price orders shipped outside your country...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ShippingGuidesByCountry" class="text-decoration-none" style="color: var(--lively-blue);">Shipping guides by country</a></h5>
            <p class="text-muted small">Find shipping requirements and carrier info specific to your country...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ShippingServiceOptions" class="text-decoration-none" style="color: var(--lively-blue);">Shipping service options</a></h5>
            <p class="text-muted small">Compare available carrier services and delivery speeds...</p>
        </div>

    </div>
</div>