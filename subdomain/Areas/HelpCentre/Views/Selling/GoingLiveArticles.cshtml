@{
    ViewData["Title"] = "Going live - Lively Help Center";
    ViewData["CategorySlug"] = "Selling";
    ViewData["SubCategorySlug"] = "Going live";
    ViewData["HeroTitle"] = "Going live";
    ViewData["HeroStyle"] = "background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/help_centre_img/help_area/help_centre_hero_bg.png');";
}

<div class="container py-5 content-container">
    <div class="row g-4">

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ScheduleShow" class="text-decoration-none" style="color: var(--lively-blue);">Schedule, edit, and start a show</a></h5>
            <p class="text-muted small">Learn how to plan your show's date, category, and thumbnail...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ShowManagement" class="text-decoration-none" style="color: var(--lively-blue);">Show management for sellers</a></h5>
            <p class="text-muted small">Manage your upcoming and live shows from Seller Hub...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="StartGiveaway" class="text-decoration-none" style="color: var(--lively-blue);">Start a Giveaway during show</a></h5>
            <p class="text-muted small">Offer free items to your audience and grow your community...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="InviteCoHost" class="text-decoration-none" style="color: var(--lively-blue);">Invite a co-host to your show</a></h5>
            <p class="text-muted small">Add a co-host to help run your live show together...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="RaidShow" class="text-decoration-none" style="color: var(--lively-blue);">Raid another seller's show</a></h5>
            <p class="text-muted small">Support fellow sellers by bringing your audience into their live show...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="UnderstandShowPerformance" class="text-decoration-none" style="color: var(--lively-blue);">Understand your show's performance while you're live</a></h5>
            <p class="text-muted small">Track viewers, sales, and engagement in real time during your show...</p>
        </div>

    </div>
</div>