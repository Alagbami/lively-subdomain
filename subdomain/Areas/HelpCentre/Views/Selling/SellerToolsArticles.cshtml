@{
    ViewData["Title"] = "Seller tools - Lively Help Center";
    ViewData["CategorySlug"] = "Selling";
    ViewData["SubCategorySlug"] = "Seller tools";
    ViewData["HeroTitle"] = "Seller tools";
    ViewData["HeroStyle"] = "background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/help_centre_img/help_area/help_centre_hero_bg.png');";
}

<div class="container py-5 content-container">
    <div class="row g-4">

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="LivestreamTools" class="text-decoration-none" style="color: var(--lively-blue);">Livestream Tools</a></h5>
            <p class="text-muted small">Explore tools that help you run a smoother, more engaging live show...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="PromoteTools" class="text-decoration-none" style="color: var(--lively-blue);">Promote Tools</a></h5>
            <p class="text-muted small">Use built-in promotion features to bring more buyers to your show...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="CommunityBoost" class="text-decoration-none" style="color: var(--lively-blue);">Community Boost</a></h5>
            <p class="text-muted small">Grow your following and reach new buyers on Lively...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="SurpriseSetFeature" class="text-decoration-none" style="color: var(--lively-blue);">Surprise Set Feature for Sellers</a></h5>
            <p class="text-muted small">Use Surprise Sets to add excitement and unpredictability to your show...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="AccountHealthDashboard" class="text-decoration-none" style="color: var(--lively-blue);">Account Health Dashboard</a></h5>
            <p class="text-muted small">Monitor your seller performance metrics and account standing...</p>
        </div>

        <div class="col-md-4">
            <h5 class="fw-bold mb-2"><a asp-action="ImproveSellerPerformance" class="text-decoration-none" style="color: var(--lively-blue);">Improve your Seller Performance Metrics</a></h5>
            <p class="text-muted small">Learn what impacts your seller score and how to improve it...</p>
        </div>

    </div>
</div>