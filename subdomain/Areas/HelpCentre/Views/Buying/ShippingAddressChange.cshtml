@{
    ViewData["Title"] = "Add or update your shipping address - Lively Help Center";
    ViewData["CategorySlug"] = "Buying";
    ViewData["SubCategorySlug"] = "Shipping";
    ViewData["HeroTitle"] = "Add or update your shipping address";
    ViewData["HeroStyle"] = "background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/help_centre_img/help_area/help_centre_hero_bg.png');";
    ViewData["IsArticle"] = true;
}

<div class="article-detail-page">
    <div class="article-body">

        <h2>Add or update your shipping address</h2>

        <p>Your default shipping address is where your future orders will be sent. You can update it anytime before you buy.</p>

        <h3>Update your shipping address in the app</h3>
        <ol>
            <li>Tap <strong>Account</strong></li>
            <li>Scroll down and tap <strong>Addresses</strong></li>
            <li>Tap the + icon, or choose a saved address to edit or delete</li>
        </ol>

        <h3>Update your shipping address on web</h3>
        <ol>
            <li>From <a href="https://lively.com">lively.com</a>, click your <strong>account icon</strong> in the top right</li>
            <li>Under the <strong>Buying</strong> tab, open your <a asp-action="Index" asp-controller="Home">Payment &amp; Shipping Settings</a></li>
            <li>Click <strong>Addresses</strong> on the left</li>
            <li>Click <strong>Add</strong>, or use the <strong>··· More</strong> icon next to an address to edit or delete</li>
        </ol>

        <div class="article-info-box">
            <strong>Tip:</strong> If you're watching a show, tap the <strong>Wallet icon</strong> &gt; <strong>Shipping</strong> to make a quick change. Updates here will apply to future purchases.
        </div>

        <p>Need to fix the address for an existing order? <a asp-action="ShippingAddress">How to change your order's shipping address</a></p>

        <div class="helpful-widget">
            <p>Was this article helpful?</p>
            <div class="helpful-buttons">
                <button type="button">Yes</button>
                <button type="button">No</button>
            </div>
            <span>80 out of 145 found this helpful</span>
        </div>

    </div>
</div>