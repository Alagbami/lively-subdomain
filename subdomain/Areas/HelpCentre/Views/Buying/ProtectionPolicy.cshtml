@{
    ViewData["Title"] = "Lively Buyer Protection Policy - Lively Help Center";
    ViewData["CategorySlug"] = "Buying";
    ViewData["SubCategorySlug"] = "Order issues and refunds";
    ViewData["HeroTitle"] = "Lively Buyer Protection Policy";
    ViewData["HeroStyle"] = "background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('/img/contact_area/contact_hero_bg.png');";
    ViewData["IsArticle"] = true;
}

<div class="article-detail-page">
    <div class="article-body">
        <p>At Lively, we're committed to providing you with the best shopping experience possible. Make sure to review our guidelines for when you're eligible for a refund under the Lively Buyer Protection Policy.</p>

        <h2>How to get help with a purchase</h2>
        <p>If you have an issue with your purchase, <a href="#">submit a request via the app</a>. If your issue is covered by our Buyer Protection Policy, you will be entitled to a refund.</p>

        <h2>What buyers are entitled to a refund</h2>
        <p>Our Buyer Protection Policy covers the following types of purchases made using our payment systems:</p>
        <ul>
            <li>Items that are not as described or never arrive</li>
            <li>Items that arrive damaged</li>
            <li>Counterfeit or unauthorized items</li>
        </ul>

        <h2>Additional Details</h2>
        <div class="article-info-box">
            Review detailed criteria and scenarios under our Terms of Service for more specifics on refund calculations and shipping return responsibilities.
        </div>

        <div class="helpful-widget">
            <p>Was this article helpful?</p>
            <div class="helpful-buttons">
                <button type="button">Yes</button>
                <button type="button">No</button>
            </div>
            <span>80 out of 145 found this helpful</span>
        </div>
    </div>
</div>
