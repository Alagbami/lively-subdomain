                    </tr>
                    <tr style="background:#FAFAFA;">
                        <td style="padding:12px 16px; border:1px solid #E0E0E0; vertical-align:top;">Heavy packages (5–70 lbs)</td>
                        <td style="padding:12px 16px; border:1px solid #E0E0E0; vertical-align:top;">$9.21 for <strong>Flat Rate</strong>, or <a href="#">USPS commercial rates</a> based on weight and distance</td>
                        <td style="padding:12px 16px; border:1px solid #E0E0E0; vertical-align:top;"><strong>USPS Priority Mail</strong> (default) or <strong>Flat Rate</strong></td>
                    </tr>
                </tbody>
