    ViewData["Title"] = "How to bid in an auction - Lively Help Center";
    ViewData["CategorySlug"] = "Buying";
    ViewData["SubCategorySlug"] = "Buying items";
    ViewData["HeroTitle"] = "How to bid in an auction";
    ViewData["HeroStyle"] = "background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('/img/contact_area/contact_hero_bg.png');";
