@model Rotex.Lively.Web.Client.ViewModels.ReferCreatorViewModel
@{
    ViewData["Title"] = "Refer a Creator";
}

@section Styles {
    <link rel="stylesheet" href="~/css/creatorStyle/ReferCreator.css" asp-append-version="true" />
}

<div class="rc-page">

    @* ── Header ── *@
    <header class="rc-header">
        <a href="javascript:history.back()" class="rc-back" aria-label="Go back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="rc-header__title">Refer a Creator</h1>
            <p class="rc-header__subtitle">Earn $200 for each creator who joins</p>
        </div>
    </header>

    @* ── Stats strip ── *@
    <section class="rc-stats">
        <div class="rc-stat-card">
            <div class="rc-stat-card__head">
                <span class="rc-stat-card__icon rc-stat-card__icon--purple">
                    <i class="bi bi-people"></i>
                </span>
                <span class="rc-stat-card__label">Referred</span>
            </div>
            <div class="rc-stat-card__value">@Model.ReferredCount</div>
            <div class="rc-stat-card__sub">Creators signed up</div>
        </div>

        <div class="rc-stat-card">
            <div class="rc-stat-card__head">
                <span class="rc-stat-card__icon rc-stat-card__icon--green">
                    <i class="bi bi-broadcast"></i>
                </span>
                <span class="rc-stat-card__label">Active</span>
            </div>
            <div class="rc-stat-card__value">@Model.ActiveCount</div>
            <div class="rc-stat-card__sub">Completed first show</div>
        </div>

        <div class="rc-stat-card">
            <div class="rc-stat-card__head">
                <span class="rc-stat-card__icon rc-stat-card__icon--blue">
                    <i class="bi bi-currency-dollar"></i>
                </span>
                <span class="rc-stat-card__label">Earned</span>
            </div>
            <div class="rc-stat-card__value">@Model.Currency@Model.EarnedAmount.ToString("N0")</div>
            <div class="rc-stat-card__sub">From referrals</div>
        </div>

        <div class="rc-stat-card">
            <div class="rc-stat-card__head">
                <span class="rc-stat-card__icon rc-stat-card__icon--yellow">
                    <i class="bi bi-clock"></i>
                </span>
                <span class="rc-stat-card__label rc-stat-card__label--yellow">Pending</span>
            </div>
            <div class="rc-stat-card__value rc-stat-card__value--yellow">@Model.Currency@Model.PendingAmount.ToString("N0")</div>
            <div class="rc-stat-card__sub">Being processed</div>
        </div>
    </section>

    @* ── Main two-column grid ── *@
    <div class="rc-grid">

        @* Left column *@
        <div class="rc-left">

            @* Referral link card *@
            <div class="rc-card">
                <h2 class="rc-card__title">Your referral link</h2>
                <div class="rc-link-row">
                    <span class="rc-link-url" id="rcReferralUrl">@Model.ReferralUrl</span>
                    <button type="button" class="rc-copy-btn" id="rcCopyBtn"
                            data-url="https://@Model.ReferralUrl">
                        <i class="bi bi-files"></i>
                        <span id="rcCopyLabel">Copy</span>
                    </button>
                </div>
            </div>

            @* Share via card *@
            <div class="rc-card">
                <h2 class="rc-card__title">Share Via</h2>
                <div class="rc-share-grid">
                    <button type="button" class="rc-share-btn" data-platform="facebook">
                        <i class="bi bi-facebook"></i>
                        <span>Facebook</span>
                    </button>
                    <button type="button" class="rc-share-btn" data-platform="x">
                        <i class="bi bi-twitter-x"></i>
                        <span>X</span>
                    </button>
                    <button type="button" class="rc-share-btn" data-platform="email">
                        <i class="bi bi-envelope"></i>
                        <span>Email</span>
                    </button>
                    <button type="button" class="rc-share-btn" data-platform="tiktok">
                        <i class="bi bi-tiktok"></i>
                        <span>Tiktok</span>
                    </button>
                </div>
            </div>
        </div>

        @* Right column — How it works *@
        <div class="rc-right">
            <div class="rc-card rc-card--full-height">
                <h2 class="rc-card__title">How it works</h2>
                <ol class="rc-steps">
                    @foreach (var step in Model.Steps)
                    {
                        <li class="rc-step">
                            <span class="rc-step__num">@step.Number</span>
                            <div class="rc-step__body">
                                <div class="rc-step__title">@step.Title</div>
                                <div class="rc-step__desc">@step.Description</div>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </div>
    </div>

    @* ── Program Terms ── *@
    <div class="rc-terms">
        <div class="rc-terms__head">
            <i class="bi bi-info-circle"></i>
            <h2 class="rc-terms__title">Program Terms</h2>
        </div>
        <ul class="rc-terms__list">
            @foreach (var term in Model.ProgramTerms)
            {
                <li>@term</li>
            }
        </ul>
    </div>

</div>

@section Scripts {
    <script src="~/js/creator/referCreator.js" asp-append-version="true"></script>
}

