<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lively</title>

    

    <partial name="_LayoutStyles" />

    <link rel="stylesheet" href="~/css/contact-area.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <partial name="~/Views/Shared/Contact/_ContactMenu.cshtml" />
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted" id="pageFooter">
        <partial name="~/Views/Shared/Contact/_ContactFooter.cshtml" />
    </footer>

    <!-- Bootstrap JS -->
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
