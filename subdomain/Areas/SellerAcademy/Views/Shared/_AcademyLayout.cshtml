@{
    var activePage = (ViewData["ActivePage"] as string) ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lively Seller Academy</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/seller-academy.css" asp-append-version="true" />
</head>
<body class="academy-body">

    <partial name="~/Areas/SellerAcademy/Views/Shared/_AcademyNav.cshtml" model="activePage" />

    <main class="academy-main">
        @RenderBody()
    </main>

    <partial name="~/Areas/SellerAcademy/Views/Shared/_AcademyFooter.cshtml" />

    <script src="~/js/seller-academy.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>