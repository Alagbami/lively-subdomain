@model YourNamespace.Areas.Legal.ViewModels.LegalPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

@section Sidebar {
    <nav class="legal-sidebar-nav" id="legalSidebarNav">
        <div class="sidebar-doc-title active">
            Terms and conditions (English)
            <img src="~/img/arrow-up.svg" class="chevron-icon" alt="expanded" />
        </div>
        <ul class="sidebar-section-list" id="sidebarSectionList">
            @foreach (var legalSection in Model.Sections)
            {
                <li>
                    <a href="#@legalSection.AnchorId"
                       class="sidebar-link"
                       data-section="@legalSection.AnchorId">
                        @legalSection.NavLabel
                    </a>
                </li>
            }
        </ul>
        <div class="sidebar-doc-title">
            <a asp-area="Legal"
               asp-controller="Legal"
               asp-action="PrivacyPolicy">
                Privacy and Policy (English)
                <img src="~/img/arrow-down.svg" class="chevron-icon" alt="collapsed" />
            </a>
        </div>
    </nav>
}

<div class="legal-page-header">
    <h1>@Model.PageTitle</h1>
    <div class="legal-meta">
        <span>Version @Model.Version</span>
        <span>Last Updated: @Model.LastUpdated</span>
        <a asp-area="Legal"
           asp-controller="Legal"
           asp-action="DownloadPdf"
           asp-route-document="@Model.PdfDownloadDocument"
           class="download-pdf">
            &#8595; Download PDF
        </a>
    </div>
</div>

@foreach (var legalSection in Model.Sections)
{
    <section id="@legalSection.AnchorId" class="legal-section">
        <h2>@legalSection.SectionNumber. @legalSection.Title</h2>

        @foreach (var clause in legalSection.Clauses)
        {
            <p><strong>@clause.Number</strong> @Html.Raw(clause.Text)</p>

            @if (clause.SubClauses.Any())
            {
                <div class="sub-clauses">
                    @foreach (var sub in clause.SubClauses)
                    {
                        <p class="sub-clause">
                            <strong>@Html.Raw(sub.Label)</strong> @Html.Raw(sub.Text)
                        </p>
                    }
                </div>
            }
        }
    </section>
}

@section Scripts {
    <script src="~/js/legal-center-area.js"></script>
}