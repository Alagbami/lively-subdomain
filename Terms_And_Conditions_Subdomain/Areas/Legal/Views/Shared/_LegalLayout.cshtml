<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Lively Legal Center</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/legal-center-area.css" />
</head>
<body>
    @* TODO: When merged into main site, replace this standalone shell
       with the site-wide _Layout.cshtml (header/nav/footer) *@

    <header class="legal-header">
        <div class="legal-logo">
            <img src="~/img/logo.png" alt="Lively" width="100" />
        </div>
        <div class="legal-header-title">Legal Center</div>
    </header>


    <div class="legal-page-container">
        <aside class="legal-sidebar">
            @RenderSection("Sidebar", required: false)
        </aside>
        <main class="legal-content">
            @RenderBody()
        </main>
    </div>

    <footer class="legal-footer">
        <span>Copyright &copy; 2026, Lively Africa Inc.</span>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>